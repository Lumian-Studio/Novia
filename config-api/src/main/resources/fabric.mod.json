{
    "schemaVersion": 1,
    "id": "novia-config-api",
    "version": "${version}",
    "name": "${name}",
    "description": "A Novia module for building elaborate configuration systems.",
    "authors": [ "LumiaLights" ],
    "icon": "assets/novia-config-api/icon.png",
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/Novia",
        "issues": "https://github.com/LumiaLights/Novia/issues"
    },
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "client": [
            "xyz.lumian.novia.api.config.client.ConfigApiClient"
        ],
        "main": [
            "xyz.lumian.novia.api.config.ConfigApi"
        ],
        "modmenu": [
            "xyz.lumian.novia.api.config.client.gui.ConfigMenuProvider"
        ],
        "fabric-datagen": [
            "xyz.lumian.novia.api.config.data.ConfigApiDataProvider"
        ]
    },
    "mixins": [
        {
            "config": "novia-config-api.server.mixins.json",
            "environment": "server"
        },
        {
            "config": "novia-config-api.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": "${fabric_loader_version}",
        "java": "${java_version}",
        "minecraft": "${minecraft_version}",
        "novia-core-api": "*"
    }
}
