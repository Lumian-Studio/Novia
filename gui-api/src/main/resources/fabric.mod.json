{
    "schemaVersion": 1,
    "id": "novia-gui-api",
    "version": "${version}",
    "name": "${name}",
    "description": "A useful fabric module for the Novia that provides some GUI and general 2D drawing utils.",
    "authors": ["LumiaLights"],
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/Novia",
        "issues": "https://github.com/LumiaLights/Novia/issues"
    },
    "accessWidener": "novia-gui-api.accesswidener",
    "license": "MIT",
    "icon": "assets/novia-gui-api/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "xyz.lumian.novia.api.gui.GuiApi"
        ],
        "fabric-datagen": [
            "xyz.lumian.novia.api.gui.data.GuiApiDataProvider"
        ]
    },
    "mixins": [
        {
            "environment": "client",
            "config": "novia-gui-api.client.mixins.json"
        }
    ],
    "depends": {
        "fabricloader": "${fabric_loader_version}",
        "java": "${java_version}",
        "minecraft": "${minecraft_version}",
        "novia-core-api": "*"
    }
}
