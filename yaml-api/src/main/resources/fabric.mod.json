{
    "schemaVersion": 1,
    "id": "novia-yaml-api",
    "version": "${version}",
    "name": "${name}",
    "description": "A 3rd party library module that deals with the integration of YAML into Minecraft.",
    "authors": ["LumiaLights"],
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/Novia",
        "issues": "https://github.com/LumiaLights/Novia/issues"
    },
    "license": "MIT",
    "icon": "assets/novia-yaml-api/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "xyz.lumian.novia.api.yaml.YamlApi"
        ]
    },
    "mixins": [],
    "depends": {
        "fabricloader": "${fabric_loader_version}",
        "java": "${java_version}",
        "minecraft": "${minecraft_version}",
        "novia-core-api": "*"
    }
}
