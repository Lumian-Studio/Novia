package xyz.lumian.novia.api.testmod.config;

import com.mojang.serialization.Codec;
import net.minecraft.resources.Identifier;
import xyz.lumian.novia.api.config.property.Property;
import xyz.lumian.novia.api.config.schema.builtin.ConstantSchema;
import xyz.lumian.novia.api.config.spec.ConfigSpec;
import xyz.lumian.novia.api.config.spec.builder.ConfigSpecBuilder;
import xyz.lumian.novia.api.core.serialisation.Value;

import java.util.*;



//**********************************************************************************************************************
public record WidgetTestConfig(
    Property<String>              string,
    Property<Number>              number,
    Property<Boolean>             bool,
    Property<Boolean>             bool2,
    Property<Boolean>             bool3,
    Property<Optional<Boolean>>   optional,
    Property<List<Value>>         list,
    Property<Map<String, String>> map,
    
    Property<Value> constant
)
{
    //******************************************************************************************************************
    public static final Value DEFAULT_CONSTANT = new Value(Map.of(
        new Value("hello_prop"), new Value("some_property"),
        new Value("and_another"), new Value(List.of(
            new Value("with_strings_and"),
            new Value(420),
            Value.TRUE
        ))
    ));
    
    public static final ConfigSpec<WidgetTestConfig> SPEC
        = (new ConfigSpecBuilder<>(Identifier.parse("novia-test-mod:widget-test-config"), WidgetTestConfig.class))
            .withGroup("primitives", bg -> bg
                .withProperty("string",   WidgetTestConfig::string)
                .withProperty("number",   WidgetTestConfig::number)
                .withProperty("bool",     WidgetTestConfig::bool)
                .withProperty("bool2",    WidgetTestConfig::bool2)
                .withProperty("bool3",    WidgetTestConfig::bool3)
                .withProperty("optional", WidgetTestConfig::optional)
                .withProperty("list",     WidgetTestConfig::list)
                .withProperty("map",      WidgetTestConfig::map))
            .withGroup("complex", bg -> bg
                .withProperty("constant", WidgetTestConfig::constant, (p -> p
                    .withSchema(new ConstantSchema<>(WidgetTestConfig.DEFAULT_CONSTANT)))))
            .build(WidgetTestConfig::new);
    
    //******************************************************************************************************************
    public WidgetTestConfig()
    {
        this(
            Property.string("Hello world!"),
            Property.number(400),
            Property.bool(true),
            Property.bool(false),
            Property.bool(true),
            Property.optional(Optional.empty(), Codec.BOOL),
            Property.list(List.of(), Value.CODEC),
            Property.map(Map.of(), Codec.STRING, Codec.STRING),
            
            Property.var(WidgetTestConfig.DEFAULT_CONSTANT)
        );
    }
}
