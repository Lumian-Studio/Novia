{
    "schemaVersion": 1,
    "id": "novia-core-api",
    "version": "${version}",
    "name": "${name}",
    "description": "Core module for Novia API.",
    "authors": [ "LumiaLights" ],
    "contact": {
        "homepage": "https://lumialights.xyz/",
        "sources": "https://github.com/LumiaLights/NoviaAPI",
        "issues": "https://github.com/LumiaLights/NoviaAPI/issues"
    },
    "license": "MIT",
    "icon": "assets/novia-core-api/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "xyz.lumian.novia.api.core.Novia"
        ],
        "client": [
            "xyz.lumian.novia.api.core.client.NoviaClientHandler"
        ],
        "server": [
            "xyz.lumian.novia.api.core.NoviaServerHandler"
        ]
    },
    "mixins": [
        "novia-core-api.mixins.json",
        {
            "config": "novia-core-api.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": "${fabric_loader_version}",
        "java": "${java_version}",
        "minecraft": "${minecraft_version}"
    }
}
